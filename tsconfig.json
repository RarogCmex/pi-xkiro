{
  // Тайпчек против типов пи:
  //   npm run typecheck   (tsc -p tsconfig.json)
  //
  // Требует один раз слинковать пакеты самого pi (вне гита):
  //   node scripts/link-pi.mjs
  // Скрипт сам находит глобальную установку pi (префикс npm, nvm, pnpm,
  // ~/.local, /usr/local или каталог, куда резолвится исполняемый `pi`) и
  // линкует @earendil-works/pi-coding-agent, @earendil-works/pi-ai и @types/node
  // (на Windows — junctions). Для конкретной установки:
  //   PI_ROOT=/path/to/node_modules node scripts/link-pi.mjs  //     node_modules/@types/node
  //
  // `paths` mirrors pi's extension loader, which aliases the bare
  // "@earendil-works/pi-ai" specifier to pi-ai's compat entrypoint (a strict
  // superset of the core one). Without this, tsc resolves the bare specifier to
  // dist/index.d.ts and reports openAICompletionsApi as missing even though pi
  // provides it at runtime. See the note in index.ts.
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@earendil-works/pi-ai": ["./node_modules/@earendil-works/pi-ai/dist/compat.d.ts"],
      "@earendil-works/pi-ai/*": [
        "./node_modules/@earendil-works/pi-ai/dist/*.d.ts",
        "./node_modules/@earendil-works/pi-ai/dist/*"
      ]
    }
  },
  "include": ["*.ts", "test/*.ts", "live/*.ts"]
}
